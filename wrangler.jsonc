{
  // similarize.com on Cloudflare Workers static assets (replaces GitHub Pages; mirrors Still-Has-Value/StillHasValue).
  // Workers Builds: build command `node _cf/build.mjs`, deploy command `npx wrangler deploy`, branch gh-pages.
  // _cf/build.mjs strips Jekyll front matter (index.html) and splits files > 25 MiB into cf-parts/ (served by _cf/worker.js).
  // Phase 1 (staging): workers.dev only. Do NOT add routes/custom domains here until the cutover is approved.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "similarize-site",
  "main": "_cf/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Asset-first: the Worker only runs for misses (big-file reassembly + 404), keeping invocations low on the free plan.
    "run_worker_first": false,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
  // Cutover (phase 2) adds:
  // "routes": [ { "pattern": "www.similarize.com", "custom_domain": true } ]
  // www.similarize.com/p and /p/* stay on similarize-private (routes run before a Custom Domain).
}
